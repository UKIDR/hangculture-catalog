---
import site from '../data/site.json';
import { basePath } from '../lib/institutions.js';
const { title = site.title, description = site.introduction } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#233b36" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={basePath('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${basePath('styles.css')}?v=20261104-navigation`} />
    <script is:inline defer src={basePath('reading-mode.js')}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={basePath('')} aria-label="На главную страницу справочника">
          <img class="brand-logo" src={basePath('media/ukidr-logo.png')} width="74" height="74" alt="Эмблема УКиДР Хангаласского улуса" />
          <span class="brand-text"><strong>Электронный справочник<br />учреждений культуры Хангаласского улуса</strong><small>Управление культуры и духовного развития · Хангаласский улус</small></span>
        </a>
        <nav aria-label="Основная навигация" class="top-nav">
          <a class="return-link" href="https://uk-hangalas.saha.muzkult.ru/"><span aria-hidden="true">←</span> Вернуться на сайт УКиДР</a>
          <a href={basePath('') + '#catalog'}>Учреждения</a>
          <a href={basePath('upravlenie/')}>Об управлении</a>
          <a href={basePath('') + '#about'}>О справочнике</a>
          <button class="reading-toggle" type="button" aria-expanded="false" aria-controls="reading-panel" aria-pressed="false">Версия для слабовидящих</button>
        </nav>
      </div>
    </header>
    <section id="reading-panel" class="reading-panel" aria-label="Настройки версии для слабовидящих" hidden>
      <div class="container reading-controls">
        <label>Размер текста <select id="reading-size"><option value="normal">Увеличенный</option><option value="large">Крупный</option></select></label>
        <label>Цвета <select id="reading-theme"><option value="light">Чёрный на белом</option><option value="dark">Белый на чёрном</option></select></label>
        <button id="reading-reset" type="button">Обычная версия</button>
      </div>
    </section>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-agency"><img src={basePath('media/ukidr-logo.png')} width="52" height="52" alt="" loading="lazy" /><div><strong>{site.office}</strong><p>Электронный справочник учреждений культуры Хангаласского улуса</p></div></div>
        <span>© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>
